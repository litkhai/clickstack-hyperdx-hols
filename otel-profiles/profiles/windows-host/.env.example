# windows-host reads machine-level environment variables on the Windows host (install.ps1 sets
# them). This file lists them for reference and for running the built config elsewhere.
CLICKSTACK_OTLP_ENDPOINT=gateway.internal:4317
CLICKSTACK_OTLP_INSECURE=true
CLICKSTACK_API_KEY=
# YAML lists; must not be empty (an empty include_services reports every service)
WINDOWS_HOST_SERVICES=[GameServer]
WINDOWS_HOST_PROCESS_NAMES=['^GameServer\.exe$']
WINDOWS_HOST_EC2_TAGS=['^svc\.']
