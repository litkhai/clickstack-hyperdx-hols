# vCenter Server or ESXi host with the SDK path enabled, as <protocol>://<host>.
VCENTER_ENDPOINT=

# A read-only vSphere account. Do not reuse an administrative one.
VCENTER_USERNAME=
VCENTER_PASSWORD=

# true only for a lab appliance with a self-signed certificate.
VCENTER_TLS_INSECURE_SKIP_VERIFY=

# Plus the sidecar variables in ../../sidecar/.env.example
