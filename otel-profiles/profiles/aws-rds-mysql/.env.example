# host:port of the RDS endpoint (RDS console -> Connectivity & security).
RDS_MYSQL_ENDPOINT=

# A user with the grants in README.md. RDS grants no SUPER -- see there.
RDS_MYSQL_USERNAME=
RDS_MYSQL_PASSWORD=

# AWS region the instance is in, e.g. ap-northeast-2.
AWS_REGION=

# The instance identifier (RDS console -> the instance's name), used as the
# CloudWatch DBInstanceIdentifier dimension and in the error/slow log group
# names.
RDS_DB_INSTANCE_IDENTIFIER=

# The instance's Resource ID (RDS console -> Configuration -> Resource ID,
# looks like db-ABCDEFGHIJKLMNOPQRSTUVWXYZ). Different from the identifier
# above -- this is what names the instance's stream inside the shared
# RDSOSMetrics log group.
RDS_RESOURCE_ID=

# AWS credentials for the sidecar container. Picked up directly by the AWS
# SDK's environment credential chain -- not referenced via ${env:...} in
# sidecar.config.yaml. Prefer a role/instance profile where the sidecar runs
# on AWS infrastructure; these are for everywhere else.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Plus the sidecar variables in ../../sidecar/.env.example
