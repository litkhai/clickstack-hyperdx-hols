# node_exporter /metrics endpoint. Listens on 9100 by default.
NODE_EXPORTER_ENDPOINT=

# ipmi_exporter itself. Listens on 9290 by default.
IPMI_EXPORTER_ENDPOINT=

# The BMC that ipmi_exporter should talk to, passed as the ?target= parameter.
# Credentials for it live in ipmi_exporter's own config file, not here.
IPMI_TARGET=
