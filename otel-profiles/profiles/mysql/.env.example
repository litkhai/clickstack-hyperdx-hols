# Tier A half (custom.config.yaml -- logs) needs no variables: it reads the
# error and slow query logs through the /hostfs mount, same as linux-host.

# Tier B half (sidecar.config.yaml -- metrics via the mysql receiver).
# host:port of the MySQL instance, reachable from the sidecar.
MYSQL_ENDPOINT=

# A user with at least the grants in README.md.
MYSQL_USERNAME=
MYSQL_PASSWORD=

# true only for a lab instance without TLS configured.
MYSQL_TLS_INSECURE=

# Plus the sidecar variables in ../../sidecar/.env.example
