# Copy to .env and fill in. .env is gitignored; never commit it.
#
# TARGET selects which deployment the checks and labs run against.
#   oss    the local docker compose stack in this directory
#   cloud  ClickStack in ClickHouse Cloud
TARGET=oss

# ---------------------------------------------------------------- ClickHouse
# OSS (the compose stack above).
#
# Not `default`. The all-in-one image writes a users.d override at startup that
# restricts the `default` user to the container's own localhost, so from the
# host it fails with "Authentication failed". The `api` and `worker` users are
# reachable; their passwords are published dev defaults in
# ClickHouse/ClickStack's docker/clickhouse/local/users.xml, not secrets, and
# they exist only in this local image. Never reuse this shape anywhere real.
CH_URL=http://localhost:8123
CH_USER=api
CH_PASSWORD=api
CH_DATABASE=default

# Cloud: the HTTPS endpoint on port 8443, and a database of your own.
# CH_URL=https://<your-service>.<region>.<cloud>.clickhouse.cloud:8443
# CH_USER=default
# CH_PASSWORD=
# CH_DATABASE=clickstack_hol
#
# A Cloud service is often shared. Never point a lab or a verify scenario at a
# database that already holds someone else's data -- create your own first with
# sql/00-database.sql.

# ------------------------------------------------------------------- HyperDX
# The external API (v2). OSS publishes it on 8000; in Cloud it is your
# ClickStack service URL.
HYPERDX_API_URL=http://localhost:8000

# Personal API access key, created in the ClickStack UI under Team Settings.
# Needed for the search check.
HYPERDX_API_KEY=

# Ingestion API key, also from Team Settings -> API Keys, and NOT the same as
# the key above. ClickStack's OTLP receiver rejects unauthenticated data, so
# bin/verify.sh cannot send anything without it.
HYPERDX_INGESTION_KEY=

# ----------------------------------------------------------------- Collector
# OSS only. Not reachable for Cloud, where the collector is yours to run and
# these checks are skipped.
COLLECTOR_HEALTH_URL=http://localhost:13133
COLLECTOR_METRICS_URL=http://localhost:8888/metrics

# Set to mount a merged profile config into the collector. Generate it with
# otel-profiles/bin/build-config.sh and uncomment the matching volume line in
# docker-compose.yml.
CUSTOM_OTELCOL_CONFIG_FILE=

# -------------------------------------------------------------- Elasticsearch
# Optional, for labs/elastic-migration/data/ only. Off by default -- start it
# with `docker compose --profile elastic up -d`. Security is disabled on this
# throwaway instance, so there is no user/password to set here.
ES_URL=http://localhost:9200
ES_INDEX=logs-demo

# Credentials for the source cluster. Security is ON by default in
# Elasticsearch 8.x, so a real cluster needs these -- the `elastic` profile
# above is the exception, not the rule. Either basic auth or an API key, never
# both: the tools refuse the combination rather than silently preferring one.
#
# Keep them here and not in a command line: an argument is visible in `ps` to
# every user on the machine and lands in shell history.
ES_USER=
ES_PASSWORD=

# The `encoded` value from POST /_security/api_key -- preferable to a user's
# password for an export, since it can be scoped and revoked.
ES_API_KEY=

# 8.x generates its own CA on first start and writes it to
# config/certs/http_ca.crt inside the container. Copy it out and point at it:
#   docker cp <container>:/usr/share/elasticsearch/config/certs/http_ca.crt ./es_ca.crt
ES_CA_CERT=

# Skip TLS verification. Warns on every call, on purpose. For a throwaway
# cluster with a self-signed certificate and nothing else.
ES_INSECURE=

# For `docker compose --profile elastic-secure up -d`: the same Elasticsearch
# with security on, on port 9201, for exercising the authenticated path.
# A published local default; override it here if you like.
ES_SECURE_PASSWORD=elastic-local-only

# ------------------------------------------------------- Migration target CH
# Where labs/elastic-migration/data/ *lands*, which is not the ClickHouse
# above. The all-in-one image bundles 26.8.7.19; a Cloud migration lands on
# the regular release channel, currently the 26.6 line, so the target is
# pinned there (see docker-compose.yml). Verifying against a newer ClickHouse
# than the destination can prove a feature the destination does not have.
#
# Leave these unset to send the migration into the ClickStack ClickHouse
# instead; every CH_TARGET_* falls back to its CH_* equivalent.
#
# For a real migration, point these at your Cloud service: the HTTPS endpoint
# on 8443, and a database created for the migration.
CH_TARGET_URL=http://localhost:8124
CH_TARGET_USER=default
CH_TARGET_PASSWORD=
CH_TARGET_DATABASE=default
