# Copy to .env and fill in. .env is gitignored; never commit it.
#
# TARGET selects which deployment the checks and labs run against.
#   oss    the local docker compose stack in this directory
#   cloud  ClickStack in ClickHouse Cloud
TARGET=oss

# ---------------------------------------------------------------- ClickHouse
# OSS (the compose stack above).
#
# Not `default`. The all-in-one image writes a users.d override at startup that
# restricts the `default` user to the container's own localhost, so from the
# host it fails with "Authentication failed". The `api` and `worker` users are
# reachable; their passwords are published dev defaults in
# ClickHouse/ClickStack's docker/clickhouse/local/users.xml, not secrets, and
# they exist only in this local image. Never reuse this shape anywhere real.
CH_URL=http://localhost:8123
CH_USER=api
CH_PASSWORD=api
CH_DATABASE=default

# Cloud: the HTTPS endpoint on port 8443, and a database of your own.
# CH_URL=https://<your-service>.<region>.<cloud>.clickhouse.cloud:8443
# CH_USER=default
# CH_PASSWORD=
# CH_DATABASE=clickstack_hol
#
# A Cloud service is often shared. Never point a lab or a verify scenario at a
# database that already holds someone else's data -- create your own first with
# sql/00-database.sql.

# ------------------------------------------------------------------- HyperDX
# The external API (v2). OSS publishes it on 8000; in Cloud it is your
# ClickStack service URL.
HYPERDX_API_URL=http://localhost:8000

# Personal API access key, created in the ClickStack UI under Team Settings.
# Needed for the search check.
HYPERDX_API_KEY=

# Ingestion API key, also from Team Settings -> API Keys, and NOT the same as
# the key above. ClickStack's OTLP receiver rejects unauthenticated data, so
# bin/verify.sh cannot send anything without it.
HYPERDX_INGESTION_KEY=

# ----------------------------------------------------------------- Collector
# OSS only. Not reachable for Cloud, where the collector is yours to run and
# these checks are skipped.
COLLECTOR_HEALTH_URL=http://localhost:13133
COLLECTOR_METRICS_URL=http://localhost:8888/metrics

# Set to mount a merged profile config into the collector. Generate it with
# otel-profiles/bin/build-config.sh and uncomment the matching volume line in
# docker-compose.yml.
CUSTOM_OTELCOL_CONFIG_FILE=
