# Copy to .env (gitignored). Holds only the path of the shared credentials file
# and non-secret settings -- never the credentials themselves.
#
# CH_ENV_FILE must point to a file that defines:
#   CH_HOST      the Cloud service host name (HTTPS, port 8443 is used)
#   CH_USER      a user that may create objects in database apm_workflows
#   CH_PASSWORD  its password
# Other variables in that file (CH_PORT, CH_DATABASE, ...) are ignored.
CH_ENV_FILE=
