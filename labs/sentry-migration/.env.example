# Copy to .env (gitignored). The DSNs the bridge accepts:
#   <project_id>:<public_key>:<service.name>
# One per client kind in this lab: game launcher, game client, mobile app.
PROJECTS=101:0a1b2c3d4e5f60718293a4b5c6d7e8f9:game-launcher,102:1b2c3d4e5f60718293a4b5c6d7e8f90a:game-client,103:2c3d4e5f60718293a4b5c6d7e8f90a1b:mobile-app

# Ingestion API key from HyperDX Team Settings (http://localhost:18080).
# Fill it after the first sign-up, then `docker compose up -d bridge`.
INGESTION_KEY=

# Where the tee goes. The lab default is the mock; in a real migration this is
# the existing Sentry ingest host.
UPSTREAM_URL=http://upstream:9900
