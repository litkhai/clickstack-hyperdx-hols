# Managed ClickStack (ClickHouse Cloud). Copy to .env (mode 600, gitignored). docker compose reads
# .env by itself; bin/check.py needs it in the environment: set -a; . ./.env; set +a
# Leave this file absent for the local ClickStack.
CH_ENDPOINT=tcp://<service>.<region>.aws.clickhouse.cloud:9440?secure=true
CH_HTTP_URL=https://<service>.<region>.aws.clickhouse.cloud:8443
CH_USER=default
CH_PASSWORD=
CH_DATABASE=vault_audit
CH_TTL=8760h
