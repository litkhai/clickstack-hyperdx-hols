*.DS_Store
.DS_Store

# Secrets — commit only the .example / .template counterparts
.env
.env.local
# Per-developer Claude Code settings: records local tool permissions and has
# held connection strings.
.claude/settings.local.json
*.tfvars
!*.tfvars.example

# Local artifacts
*.bak
*.log
**/test-results/
**/backup-*/
**/backup-metadata-*/
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Terraform (clickstack-config/). State and plan files hold connection
# credentials in plain text; the lock file is deliberately NOT ignored.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Collector configs generated by otel-profiles/bin/build-config.sh. Anchored,
# so the tracked per-profile fragments under otel-profiles/profiles/ and
# otel-profiles/sidecar/base.yaml are unaffected.
/otel-profiles/custom.config.yaml
/otel-profiles/sidecar/sidecar.config.yaml

# verify/ scenario run artifacts
/verify/.runs/

# Generated by the observability-waf workshop
workshops/observability-waf/artifact.md
