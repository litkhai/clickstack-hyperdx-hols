# Copy or source into the shell Terraform runs in -- these are NOT tfvars,
# they configure the empty `provider "clickhouse" {}` block in ../provider.tf
# directly. ClickHouse Cloud (managed ClickStack) mode: set all four; leave
# CLICKSTACK_ENDPOINT and CLICKSTACK_API_KEY unset.
#
#   set -a && source envs/cloud.env && set +a
#   terraform apply -var-file=envs/cloud.tfvars

# ID of the ClickHouse Cloud service running managed ClickStack.
CLICKSTACK_SERVICE_ID=

# Standard ClickHouse Cloud API credentials (console.clickhouse.cloud ->
# API Keys). The same three the rest of this provider's non-ClickStack
# resources use.
CLICKHOUSE_ORG_ID=
CLICKHOUSE_CLOUD_API_KEY=
CLICKHOUSE_CLOUD_API_SECRET=

# Silences the "Beta Resource" notice clickhouse_clickstack_* resources emit
# on every create, update and import (see ../README.md).
CLICKHOUSE_SUPPRESS_BETA_WARNINGS=true
