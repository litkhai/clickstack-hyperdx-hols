# Copy or source into the shell Terraform runs in -- these are NOT tfvars,
# they configure the empty `provider "clickhouse" {}` block in ../provider.tf
# directly. Self-hosted ClickStack mode: set these two, leave every Cloud
# variable (CLICKSTACK_SERVICE_ID, CLICKHOUSE_ORG_ID,
# CLICKHOUSE_CLOUD_API_KEY, CLICKHOUSE_CLOUD_API_SECRET) unset.
#
#   set -a && source envs/oss.env && set +a
#   terraform apply -var-file=envs/oss.tfvars

# _base/'s HyperDX external API, published on 8000.
CLICKSTACK_ENDPOINT=http://localhost:8000

# Personal API access key, created in the ClickStack UI under
# Team Settings -> API & Agents -> Personal API access key. Same key
# _base/bin/check.sh wants as HYPERDX_API_KEY.
CLICKSTACK_API_KEY=

# Silences the "Beta Resource" notice clickhouse_clickstack_* resources emit
# on every create, update and import (see ../README.md).
CLICKHOUSE_SUPPRESS_BETA_WARNINGS=true
